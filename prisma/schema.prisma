datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// MULTI-TENANT CORE
// ─────────────────────────────────────────────────────────────────────────────

model Association {
  id            String   @id @default(cuid())
  name          String
  nameNe        String?
  slug          String   @unique
  domain        String   @unique   // "eva.nibjar.com" | "bhaktapur.nibjar.com"
  logo          String?            // path to /public/ logo file
  themeColor    String   @default("#0a1040")
  accentColor   String   @default("#f59e0b")
  foundedYear   Int?
  description   String?
  descriptionNe String?
  active        Boolean  @default(true)
  plan          String   @default("basic") // for platform usage tracking
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberLinks            MemberAssociation[]
  events                 Event[]
  news                   News[]
  committee              CommitteeMember[]
  admins                 AdminUser[]
  settings               SiteSettings[]
  timeline               TimelineEntry[]
  apiLogs                ApiLog[]
  membershipApplications MembershipApplication[]
  membershipCategories   MembershipCategory[]
  associationFees        AssociationFee[]
  duesPayments           DuesPayment[]
  meetings               Meeting[]
  expenseVendors         ExpenseVendor[]
  expenses               Expense[]
  memberContributions    MemberContribution[]
  memberAccounts         MemberAccount[]
  aiUsage                AiUsage[]
  activityLogs           ActivityLog[]
  ticketTypes            TicketType[]
  ticketRegistrations    TicketRegistration[]
  designations           Designation[]
  memberGroups           MemberGroup[]
  meetingAttendance      MeetingAttendance[]
  financialYears         FinancialYear[]
  financialAccounts      FinancialAccount[]
  journalEntries         JournalEntry[]
}

// Join table — a venue can belong to multiple associations
// Each association admin controls visibility only for their own listing
model MemberAssociation {
  id               String   @id @default(cuid())
  memberId         String
  associationId    String
  memberCategoryId String?
  designationId    String?   // FK → Designation — member's role in this association (Phase B)
  visible          Boolean  @default(true)
  primary          Boolean  @default(true)
  joinedAt         DateTime @default(now())

  showPhone      Boolean  @default(false)  // whether phone is visible on public profile
  showEmail      Boolean  @default(false)  // whether email is visible on public profile

  member         Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  association    Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  memberCategory MembershipCategory? @relation(fields: [memberCategoryId], references: [id])
  designation    Designation?        @relation(fields: [designationId], references: [id])

  @@unique([memberId, associationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTENT MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Member {
  id           String   @id @default(cuid())
  name         String
  nameNe       String?  // Nepali business name
  slug         String   @unique
  location     String?
  area         String
  capacity     Int?     // nullable — some associations don't track capacity
  type         String?  // nullable — some associations don't categorise by type
  category     String?
  phones       String[] @default([])     // array of phone numbers (Phase B)
  phone        String?                    // LEGACY — kept for backward compat; use phones
  email        String?
  emailFailedAt DateTime? // set when a dues-reminder email to `email` bounces/fails; cleared on next success
  emailError    String?   // last email failure reason, shown to admin as a tooltip
  website      String?
  description  String?
  amenities    String[]
  memberSince  String?
  established  Int?
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  image        String?
  ownerName    String?  // venue owner / contact person (English)
  ownerNameNe  String?  // venue owner (Nepali)
  addressNe    String?  // bilingual address (Nepali)
  facebook     String?  // Facebook page URL or handle
  instagram    String?  // Instagram handle
  youtube      String?  // YouTube channel URL or handle
  latitude     Float?   // GPS latitude (decimal degrees) — from Nominatim geocoding
  longitude    Float?   // GPS longitude (decimal degrees) — from Nominatim geocoding
  // Owner personal / legal registration details
  firmRegNo        String?  // Firm Registration No. / फर्म दर्ता नं.
  firmType         String?  // Individual | Partnership | Private Limited
  fatherName       String?  // Father's Name / पिताको नाम
  grandfatherName  String?  // Grandfather's Name / बाजेको नाम
  spouseName       String?  // Spouse Name (Husband/Wife) / पति/पत्नी को नाम
  permWard         String?  // Owner Permanent Address — Ward No.
  permTole         String?
  permMunicipality String?
  permDistrict     String?
  permProvince     String?
  tempWard         String?  // Owner Temporary Address — Ward No.
  tempTole         String?
  tempMunicipality String?
  tempDistrict     String?
  tempProvince     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  associations           MemberAssociation[]
  duesPayments           DuesPayment[]
  contributions          MemberContribution[]
  portalAccounts         MemberAccount[]
  membershipApplications MembershipApplication[]
  committeeMemberships   CommitteeMember[]
  memberGroupLinks       MemberGroupLink[]
  meetingAttendance      MeetingAttendance[]
}

model Event {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  titleNe       String?
  description   String
  descriptionNe String?
  date          DateTime
  endDate       DateTime?
  startTime     String?   // e.g. "09:00" — stored as string, no TZ issues
  endTime       String?   // e.g. "17:00"
  location      String
  latitude      Float?    // GPS coordinates for map pin
  longitude     Float?
  type          String    // networking | training | meeting | exhibition | conference
  status        String    // upcoming | past
  attendees     Int?
  image         String?
  associationId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  association       Association? @relation(fields: [associationId], references: [id])
  rsvps             EventRsvp[]
  expenses          Expense[]
  contributions     MemberContribution[]
  ticketTypes       TicketType[]
  registrations     TicketRegistration[]
}

model News {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  titleNe       String?
  excerpt       String
  excerptNe     String?
  content       String
  contentNe     String?
  author        String
  category      String   // announcement | training | event | industry | member
  image         String?
  featured      Boolean  @default(false)
  status        String   @default("published") // published | scheduled | draft
  publishedAt   DateTime
  associationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association Association? @relation(fields: [associationId], references: [id])
}

model CommitteeMember {
  id            String   @id @default(cuid())
  name          String
  nameNe        String?
  role          String
  roleNe        String?
  roleKey       String   @default("member")
  organization  String?
  organizationNe String?
  venue         String?
  venueNe       String?
  bio           String?
  bioNe         String?
  order         Int      @default(99)
  highlighted   Boolean  @default(false)
  image         String?
  active        Boolean  @default(true)  // true = current committee; false = archived
  termYearAD    Int?     // AD year of election (e.g. 2025)
  termMonthAD   Int?     // AD month 1-12 (e.g. 7 = July)
  termYearBS    Int?     // BS year of election (e.g. 2082)
  termMonthBS   Int?     // BS month 1-12 (e.g. 3 = Ashadh)
  memberId      String?  // optional FK → Member (links committee member to registered member record)
  designationId String?  // optional FK → Designation (this person's role in the association's role vocabulary)
  associationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association Association? @relation(fields: [associationId], references: [id])
  member      Member?      @relation(fields: [memberId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])
}

// Per-association history milestones — section hidden if empty
model TimelineEntry {
  id            String   @id @default(cuid())
  associationId String
  year          Int
  title         String
  titleNe       String?
  description   String
  descriptionNe String?
  stat          String?  // decorative stat label, e.g. "20+ Founding Members"
  highlighted   Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMIN & SETTINGS
// ─────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  password         String?
  role             String    @default("admin")    // LEGACY — kept for JWT compat; use systemRole
  systemRole       String    @default("admin")    // "admin" | "editor" | "member"
  designationId    String?                         // FK → Designation
  extraPermissions String[]  @default([])          // permission overrides beyond designation
  deletedAt        DateTime?                       // soft delete — never hard-delete admin users
  associationId    String?   // null only during migration — every admin belongs to one association
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  association Association?  @relation(fields: [associationId], references: [id])
  designation Designation?  @relation(fields: [designationId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// ROLES & DESIGNATIONS
// ─────────────────────────────────────────────────────────────────────────────

// Per-association role definitions — e.g. President (admin), Secretary (editor), General Member (member)
model Designation {
  id            String   @id @default(cuid())
  associationId String
  name          String   // "President", "Secretary", "Treasurer", "General Member"
  systemRole    String   // "admin" | "editor" | "member"
  permissions   String[] // permission keys — only meaningful for "editor" systemRole
  isDefault     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association        Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  adminUsers         AdminUser[]
  memberAssociations MemberAssociation[]
  committeeMembers   CommitteeMember[]

  @@index([associationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MEMBER GROUPS (Phase B — person-mode: professions / interest groups)
// ─────────────────────────────────────────────────────────────────────────────

// Per-association group definitions — e.g. "Caterers", "Decorators", "Musicians"
model MemberGroup {
  id            String   @id @default(cuid())
  associationId String
  name          String
  nameNe        String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  members     MemberGroupLink[]

  @@index([associationId])
}

// Join table — many members can belong to many groups
model MemberGroupLink {
  id            String   @id @default(cuid())
  memberId      String
  memberGroupId String
  createdAt     DateTime @default(now())

  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberGroup MemberGroup @relation(fields: [memberGroupId], references: [id], onDelete: Cascade)

  @@unique([memberId, memberGroupId])
}

// Key/value store scoped per association — unique per (key, associationId) pair
model SiteSettings {
  id            String   @id @default(cuid())
  key           String
  value         String
  label         String
  group         String   @default("general")
  associationId String?
  updatedAt     DateTime @updatedAt

  association Association? @relation(fields: [associationId], references: [id])

  @@unique([key, associationId])
}

model MembershipApplication {
  id            String   @id @default(cuid())
  venueName     String
  ownerName     String
  phone         String
  email         String
  emailFailedAt DateTime? // set when the applicant confirmation email bounces/fails; cleared on next success
  emailError    String?   // last email failure reason, shown to admin as a tooltip
  location      String
  capacity      String?
  website       String?
  // Extended fields (from physical membership form)
  firmRegNo             String?  // Firm Registration No. / फर्म दर्ता नं.
  firmType              String?  // Individual | Partnership | Private Limited
  fatherName            String?  // Father's Name / पिताको नाम
  grandfatherName       String?  // Grandfather's Name / बाजेको नाम
  spouseName            String?  // Spouse Name (Husband/Wife) / पति/पत्नी को नाम
  permWard              String?  // Permanent Address — Ward No.
  permTole              String?  // Tole
  permMunicipality      String?  // Municipality / VDC
  permDistrict          String?  // District
  permProvince          String?  // Province
  tempWard              String?  // Temporary Address — Ward No.
  tempTole              String?
  tempMunicipality      String?
  tempDistrict          String?
  tempProvince          String?
  status        String   @default("pending") // pending | reviewed | accepted | rejected
  memberId      String?  // populated when accepted — links to the created Member record
  associationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association Association? @relation(fields: [associationId], references: [id])
  member      Member?      @relation(fields: [memberId], references: [id])
}

model AdminTask {
  id            String         @id @default(cuid())
  title         String
  description   String?
  status        String         @default("todo")    // todo | in_progress | done
  priority      String         @default("medium")  // low | medium | high
  dueDate       DateTime?
  assignee      String?
  notes         String?        // progress / follow-up notes
  completedAt   DateTime?      // set when status first becomes "done"
  associationId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subtasks      Subtask[]
  activities    TaskActivity[]
}

model Subtask {
  id          String           @id @default(cuid())
  taskId      String
  task        AdminTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  assignee    String?
  status      String           @default("todo")   // todo | done
  completedAt DateTime?
  order       Int              @default(0)
  comments    SubtaskComment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SubtaskComment {
  id         String   @id @default(cuid())
  subtaskId  String
  subtask    Subtask  @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  text       String
  authorName String   @default("Admin")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TaskActivity {
  id         String    @id @default(cuid())
  taskId     String
  task       AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action     String
  detail     String?
  actorName  String    @default("Admin")
  createdAt  DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM — nibjar.com software provider layer
// ─────────────────────────────────────────────────────────────────────────────

model PlatformUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hashed
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// API usage + error tracking per association — visible on platform dashboard
model ApiLog {
  id             String   @id @default(cuid())
  associationId  String?
  path           String
  method         String
  statusCode     Int
  responseTimeMs Int
  adminUserId    String?
  ip             String?
  errorMessage   String?
  createdAt      DateTime @default(now())

  association Association? @relation(fields: [associationId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 3 — MEMBERSHIP & DUES
// ─────────────────────────────────────────────────────────────────────────────

// Admin-configurable fee schedule per member category per association
model MembershipCategory {
  id               String   @id @default(cuid())
  associationId    String
  name             String   // "Catering", "Venue", "Decorator", etc.
  entryFee         Decimal  @default(0) @db.Decimal(10, 2)  // One-time entry/admission fee (प्रवेश शुल्क)
  monthlyFee       Decimal  @default(0) @db.Decimal(10, 2)
  annualRenewalFee Decimal  @default(0) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  association  Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  memberLinks  MemberAssociation[]
  duesPayments DuesPayment[]
}

// Custom additional fees defined by the association (e.g. ID Card, Insurance, etc.)
model AssociationFee {
  id            String   @id @default(cuid())
  associationId String
  name          String   // e.g. "ID Card Fee", "Insurance Fee"
  amount        Decimal  @db.Decimal(10, 2)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
}

// Each payment record — one row per payment (monthly, annual, or lump sum)
model DuesPayment {
  id                String    @id @default(cuid())
  associationId     String
  memberId          String
  memberCategoryId  String?   // category at time of payment (snapshot)
  type              String    // monthly | annual_renewal
  amount            Decimal   @db.Decimal(10, 2)
  periodStart       DateTime  // start of period covered
  periodEnd         DateTime  // end of period covered
  method            String    @default("pending") // cash | transfer | pending
  status            String    @default("pending") // paid | partial | pending
  dueAmount         Decimal?  @db.Decimal(10, 2)  // original obligation; when set, amount = what was paid
  receiptNumber     String?
  notes             String?
  paymentBreakdown  Json?     // [{method: string, amount: number}] — split payment lines
  recordedByAdminId String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  association    Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member         Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberCategory MembershipCategory? @relation(fields: [memberCategoryId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 6 — MEETINGS & EXPENSES
// ─────────────────────────────────────────────────────────────────────────────

model Meeting {
  id            String   @id @default(cuid())
  associationId String
  title         String
  titleNe       String?
  type          String   // agm | picnic | program | committee | special
  scheduledAt   DateTime
  venue         String?
  description   String?
  descriptionNe String?
  status        String   @default("scheduled") // scheduled | completed | cancelled
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association   Association          @relation(fields: [associationId], references: [id], onDelete: Cascade)
  agendaItems   AgendaItem[]
  minutes       MeetingMinutes?
  expenses      Expense[]
  contributions MemberContribution[]
  rsvps         MeetingRsvp[]
  attendance    MeetingAttendance[]
}

// Per-meeting attendance record — admin marks which members were physically present
model MeetingAttendance {
  id                String   @id @default(cuid())
  meetingId         String
  memberId          String
  associationId     String
  note              String?  // optional note (e.g. "arrived late")
  recordedByAdminId String?
  createdAt         DateTime @default(now())

  meeting     Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@unique([meetingId, memberId])
  @@index([meetingId])
}

model AgendaItem {
  id          String   @id @default(cuid())
  meetingId   String
  order       Int      @default(0)
  title       String
  description String?
  outcome     String?
  resolved    Boolean  @default(false)  // Phase C — item marked as resolved with outcome
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model MeetingMinutes {
  id          String    @id @default(cuid())
  meetingId   String    @unique
  content     String
  contentNe   String?   // Phase C — Nepali translation of minutes
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

// Reusable vendor list per association
model ExpenseVendor {
  id            String   @id @default(cuid())
  associationId String
  name          String
  category      String?  // food | transport | venue | printing | other
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  expenses    Expense[]
}

// Expense line item — attaches to a Meeting OR an Event
model Expense {
  id            String   @id @default(cuid())
  associationId String
  meetingId     String?
  eventId       String?
  vendorId      String?  // FK to ExpenseVendor (optional)
  vendorName    String?  // free-text fallback if no vendorId
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  meeting     Meeting?       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  event       Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor      ExpenseVendor? @relation(fields: [vendorId], references: [id])
}

// Per-member contribution to a meeting or event
model MemberContribution {
  id                String    @id @default(cuid())
  associationId     String
  memberId          String
  meetingId         String?
  eventId           String?
  amount            Decimal   @db.Decimal(10, 2)
  method            String    @default("pending") // cash | cheque | qr | transfer | esewa | khalti | mixed | pending
  status            String    @default("pending") // paid | pending
  paymentBreakdown  Json?     // [{method: string, amount: number}] — split payment lines
  notes             String?
  recordedByAdminId String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meeting     Meeting?    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  event       Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 4 — MEMBER PORTAL
// ─────────────────────────────────────────────────────────────────────────────

// One portal account per member per association — created by admin
model MemberAccount {
  id            String    @id @default(cuid())
  memberId      String
  associationId String
  email         String
  emailFailedAt DateTime? // set when a notification email to `email` bounces/fails; cleared on next success
  emailError    String?   // last email failure reason, shown to admin as a tooltip
  passwordHash  String
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  association  Association   @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingRsvps MeetingRsvp[]
  eventRsvps   EventRsvp[]

  @@unique([email, associationId])
  @@unique([memberId, associationId])
}

model MeetingRsvp {
  id              String   @id @default(cuid())
  meetingId       String
  memberAccountId String
  status          String   @default("attending") // attending | not_attending | maybe
  guestCount      Int      @default(1)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  meeting       Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberAccount MemberAccount @relation(fields: [memberAccountId], references: [id], onDelete: Cascade)

  @@unique([meetingId, memberAccountId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI USAGE TRACKING
// ─────────────────────────────────────────────────────────────────────────────

// One row per association per calendar day — upserted on every AI generation
model AiUsage {
  id            String   @id @default(cuid())
  associationId String
  date          String   // "YYYY-MM-DD" — easy daily grouping, no TZ issues
  count         Int      @default(0)
  updatedAt     DateTime @updatedAt

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@unique([associationId, date])
}

model EventRsvp {
  id              String   @id @default(cuid())
  eventId         String
  memberAccountId String
  status          String   @default("attending") // attending | not_attending | maybe
  guestCount      Int      @default(1)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberAccount MemberAccount @relation(fields: [memberAccountId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberAccountId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ACTIVITY LOG
// ─────────────────────────────────────────────────────────────────────────────

model ActivityLog {
  id            String   @id @default(cuid())
  associationId String
  adminId       String?  // null for system/public actions
  adminName     String?  // snapshot of admin name at log time
  action        String   // e.g. "member.create", "event.delete", "application.approve"
  entityType    String   // "member" | "event" | "news" | "committee" | "meeting" | "application" | "dues" | "task"
  entityId      String?
  entityName    String?  // human-readable label, e.g. venue name or event title
  meta          Json?    // optional extra data (e.g. old status → new status)
  createdAt     DateTime @default(now())

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId, createdAt(sort: Desc)])
  @@index([associationId, entityType])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENT TICKETING
// ─────────────────────────────────────────────────────────────────────────────

model TicketType {
  id             String   @id @default(cuid())
  eventId        String
  associationId  String
  name           String   // e.g. "VIP", "General", "Table (10 seats)"
  description    String?
  section        String?  // free-text seating zone, e.g. "Banquet Hall A"
  price          Decimal  @default(0)
  memberPrice    Decimal? // optional discounted price for members
  totalCapacity  Int?     // null = unlimited
  strictCapacity Boolean  @default(false) // if true, block when soldCount >= capacity
  soldCount      Int      @default(0)     // maintained by API
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  association   Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  registrations TicketRegistration[]

  @@index([eventId])
}

model TicketRegistration {
  id             String   @id @default(cuid())
  ticketTypeId   String
  eventId        String
  associationId  String

  // Buyer
  buyerName      String
  buyerEmail     String
  emailFailedAt  DateTime? // set when a confirmation/payment email to buyerEmail bounces/fails; cleared on next success
  emailError     String?   // last email failure reason, shown to admin as a tooltip
  buyerPhone     String
  notes          String?
  quantity       Int      @default(1)

  // Payment
  paymentStatus  String   @default("pending") // pending | paid | cancelled | refunded
  amount         Decimal?
  paymentMethod  String?  // cash | bank_transfer | cheque | other
  receiptNumber  String?
  paidAt         DateTime?
  recordedByAdminId String?

  // Cancellation / refund
  cancelledAt    DateTime?
  cancelReason   String?
  refundedAt     DateTime?
  refundAmount   Decimal?

  // Check-in
  checkInToken   String   @unique @default(cuid())
  checkedIn      Boolean  @default(false)
  checkedInAt    DateTime?
  checkedInBy    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ticketType    TicketType  @relation(fields: [ticketTypeId], references: [id])
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([associationId])
  @@index([checkInToken])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE D — FINANCIAL LEDGER
// ─────────────────────────────────────────────────────────────────────────────

// One fiscal year per association (or multiple years side-by-side)
model FinancialYear {
  id             String    @id @default(cuid())
  associationId  String
  label          String    // "FY 2081-82" | "FY 2024-25"
  startDateAD    DateTime
  endDateAD      DateTime
  openingBalance Decimal   @default(0) @db.Decimal(10, 2)
  status         String    @default("active") // "active" | "closed"
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  association    Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@index([associationId])
}

// Chart of accounts — 10 preset defaults seeded per association, plus custom
model FinancialAccount {
  id            String   @id @default(cuid())
  associationId String
  code          String   // "1001"
  name          String   // "Cash in Hand"
  type          String   // "asset" | "income" | "expense" | "liability"
  isDefault     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association   Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  debitEntries  JournalEntry[] @relation("DebitAccount")
  creditEntries JournalEntry[] @relation("CreditAccount")

  @@unique([associationId, code])
  @@index([associationId])
}

// Double-entry ledger — one entry per transaction
// Treasurer sees simple in/out view; double-entry is internal
model JournalEntry {
  id               String   @id @default(cuid())
  associationId    String
  financialYearId  String
  date             DateTime
  description      String
  debitAccountId   String
  creditAccountId  String
  amount           Decimal  @db.Decimal(10, 2)
  reference        String?  // receipt / voucher number
  entityType       String?  // "dues" | "expense" | "contribution" | "ticket" | "manual"
  entityId         String?  // FK to source record (DuesPayment, Expense, etc.)
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  association   Association      @relation(fields: [associationId], references: [id], onDelete: Cascade)
  financialYear FinancialYear    @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  debitAccount  FinancialAccount @relation("DebitAccount",  fields: [debitAccountId],  references: [id])
  creditAccount FinancialAccount @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@index([associationId, financialYearId, date])
  @@index([entityType, entityId])
}
